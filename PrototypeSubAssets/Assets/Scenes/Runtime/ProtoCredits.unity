  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Developers:</size></b>\r\n\r\n<b>Christian \u201COctorion\u201D Howlings</b>\r\n-
    Prototech director\r\n- 3D assets\r\n- Gameplay design & coordination\r\n- Narrative
    design\r\n- Voice acting (Or-Ion, Lifepod 3 crew #1)\r\n\r\n<b>GamingForFun (IndigoCoder)</b>\r\n-
    Programming & technical lead\r\n- Design & implementation\r\n- Sub Library creation\r\n\r\n<b>Mika
    \u201CDeamoz\u201D Kontenak</b>\r\n- Sound design & OST\r\n\r\n<b>Aksel \u201CClubEar\u201D
    Sisk</b>\r\n- 2D Assets\r\n- Concept art\r\n- Level design\r\n\r\n<b>Lyonic</b>\r\n-
    Programming\r\n- Material database creation\r\n\r\n<b>Limitless</b>\r\n- Programming\r\n\r\n<b><size=60>Collaborators:</size></b>\r\n\r\n<b>Leif
    \u201CScarab\u201D Fairbairn</b>\r\n- Voice acting (Alec Mason)\r\n\r\n<b>SteveKong</b>\r\n-
    Video & trailer creation\r\n\r\n<b>N8Crafter</b>\r\n- Precursor tiles & 3D art
    consultant\r\n- Return of the Ancients integration consultant\r\n\r\n<b>Lilly23
    (Snom/NoContextLilly)</b>\r\n- The Red Plague integration\r\n\r\n<b>Dr.Dyers</b>\r\n-
    Prototech team logo\r\n\r\n<b><size=60>Playtesters:</size></b>\r\n\r\n<b>Rip_Angel,
    IanZeArtist, Dragoncat, Bucketato, Sebazavrik, Al-An, Erik990, Dreamanchik, KooKoo,
    CRLD, Deltenic</b>\r\n\r\n<b><size=60>Special Thanks:</size></b>\r\n\r\n<b>RedDev</b>\r\n<b>Artyom
    (MildBlobFish)</b>\r\n<b>FoulHawk</b>\r\n<b>Kallie23</b>\r\n<b>Metious</b>\r\n<b>MonikaCinnyRoll</b>\r\n<b>Obraxis</b>\r\n<b>Sebazavrik</b>\r\n<b>TheLastBacon</b>\r\n<b>IGP</b>\r\n<b>Charlie
    \u201CFlayra\u201D Cleveland</b>\r\n<b>The amazing Subnautica Modding community</b>\r\n\r\n<b>...And
    you!</b>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
